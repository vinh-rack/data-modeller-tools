# Copy to .env and fill in locally. NEVER COMMIT .env

# Folder holding the baseline SMX workbooks (read-only)
DMA_SMX_DIR=tests/fixtures/smx
# Path to a dbt manifest.json (v12)
DMA_DBT_MANIFEST=tests/fixtures/dbt/manifest.json
# Local clone of the dbt repo, read as code only (no dbt command, no Jinja rendering). Clone it yourself once.
DMA_DBT_REPO=
# auto: git pull --ff-only in DMA_DBT_REPO at most once a day. off: never pull.
DMA_DBT_PULL=auto
# The only folder the artifact writer may write to
DMA_OUTPUT_DIR=output
# Folder holding smx_mapping.yaml and rules.yaml
DMA_CONFIG_DIR=config
# stdio (v1, each modeller's IDE) or http (v2, the hosted server; the container sets it).
DMA_TRANSPORT=stdio
# Who is recorded on every gate decision in stdio mode. Empty: the OS user. HTTP mode ignores it and takes the user from the token.
DMA_USER=

# Redshift metadata connector (stub in v0, use a read-only user)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=

# Databricks metadata connector (stub in v0, use a read-only token)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Power BI REST API (read-only). Phase 0 uses a delegated user token:

# CLI Commands to get a token (requires Power BI PowerShell module):
#
# Connect-PowerBIServiceAccount
# Get-PowerBIAccessToken -AsString

# Paste the whole string; the "Bearer " included. Never commit a real token.
PBI_ACCESS_TOKEN=
PBI_API_BASE=https://api.powerbi.com/v1.0/myorg
# Row cap for metadata DAX queries
PBI_MAX_ROWS=5000
# Used only by scripts/pbi_probe.py. Leave PBI_WORKSPACE_ID empty for My workspace, or set it to test the group paths.
PBI_REPORT_ID=
PBI_DATASET_ID=
PBI_WORKSPACE_ID=
# Power BI scope for the hosted on-behalf-of exchange (DMA_AUTH=entra only). The default is Microsoft's documented one.
PBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# ---------------------------------------------------------------------------
# v2 hosted (DMA_TRANSPORT=http). Ignored in stdio mode. See README, "v2: hosted".
# Never bake any of these into the image: pass them at run time (env_file, a secrets store).
# ---------------------------------------------------------------------------

# One data root for output/, smx/, kb/ and dbt/. The container sets /data. Unset: the v1 paths above apply.
DMA_DATA_DIR=
# Listen address and path. The container sets 0.0.0.0; keep 127.0.0.1 outside a container.
DMA_HTTP_HOST=127.0.0.1
DMA_HTTP_PORT=8000
DMA_HTTP_PATH=/mcp
# The public URL of the MCP endpoint, as clients reach it: the resource in Protected Resource Metadata.
# Default https://<DMA_HTTP_HOST><DMA_HTTP_PATH>. Behind a TLS proxy, e.g. https://dma.example.com/mcp
DMA_RESOURCE_SERVER_URL=
# Allowed Host and Origin headers (comma lists; "host:*" allows any port). Empty: the resource URL's host plus loopback.
DMA_ALLOWED_HOSTS=
DMA_ALLOWED_ORIGINS=
# 1: trust X-Forwarded-* from the proxies in FORWARDED_ALLOW_IPS (uvicorn's own variable, default 127.0.0.1). 0: ignore them.
DMA_PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=
# Git commit shown by /health. The image sets it from the build argument of the same name.
DMA_GIT_COMMIT=

# Authentication. HTTP mode refuses to start without it: entra (shared server) or dev (local Docker only).
DMA_AUTH=

# dev: one static bearer token, 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
DMA_DEV_TOKEN=
DMA_DEV_USER_ID=dev
DMA_DEV_USER_NAME=Dev user
# dev mode refuses any host but 127.0.0.1 unless this is 1. docker-compose.yml sets it and publishes the port on 127.0.0.1 only.
DMA_ALLOW_DEV_AUTH_ON_NETWORK=

# entra: the API app registration (v2 access tokens, requestedAccessTokenVersion=2).
DMA_ENTRA_TENANT_ID=
DMA_ENTRA_CLIENT_ID=
# App ID URI of the API, e.g. api://<client id>. Tokens may carry it or the client id as the audience.
DMA_ENTRA_AUDIENCE=
# Scopes every caller needs, full or short names (dma.access means <DMA_ENTRA_AUDIENCE>/dma.access).
DMA_REQUIRED_SCOPES=
# Optional allowlists (comma lists of object ids). Users match on the oid claim; groups need the groups claim.
DMA_ALLOWED_USERS=
DMA_ALLOWED_GROUPS=
# The OBO credential for Power BI: a client secret, or a certificate (PEM private key file plus its thumbprint). Exactly one.
DMA_ENTRA_CLIENT_SECRET=
DMA_ENTRA_CERT_PATH=
DMA_ENTRA_CERT_THUMBPRINT=

# dbt repo for the container: cloned once into <DMA_DATA_DIR>/dbt at start if missing, then pulled daily (DMA_DBT_PULL).
# https URL without credentials. The read-only token is passed to each git command only, never written to disk.
DMA_DBT_REPO_URL=
DMA_DBT_GIT_TOKEN=
# User name sent with the token (HTTPS Basic). x-access-token works for GitHub, Azure DevOps and GitLab tokens.
DMA_DBT_GIT_USER=x-access-token
